{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anemos",
  "identifier": "com.anemos.app",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WhisperCode"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../ios/WhisperCode/WhisperCode/Assets.xcassets/AppIcon.appiconset/AppIcon-dark.png"]
  }
}
